<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sole entitlement required to install/uninstall the system extension.
	     Without a developer account, ad-hoc signing + systemextensionsctl developer on. -->
	<key>com.apple.developer.system-extension.install</key>
	<true/>
</dict>
</plist>
